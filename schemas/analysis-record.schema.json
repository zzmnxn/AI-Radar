{
  "$defs": {
    "Access": {
      "additionalProperties": false,
      "properties": {
        "note_ko": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note Ko"
        },
        "type": {
          "enum": [
            "open",
            "signup",
            "waitlist",
            "paid",
            "enterprise",
            "region_limited",
            "api_only",
            "unknown"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "Access",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "evidence_quote": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evidence Quote",
          "type": "string"
        },
        "evidence_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Evidence Url",
          "type": "string"
        },
        "role": {
          "enum": [
            "what",
            "why",
            "how",
            "availability",
            "access"
          ],
          "title": "Role",
          "type": "string"
        },
        "sentence_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentence Index"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "role",
        "text",
        "evidence_url",
        "evidence_quote"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimCheck": {
      "additionalProperties": false,
      "properties": {
        "numbers_match": {
          "title": "Numbers Match",
          "type": "boolean"
        },
        "quote_found": {
          "title": "Quote Found",
          "type": "boolean"
        },
        "role": {
          "enum": [
            "what",
            "why",
            "how",
            "availability",
            "access"
          ],
          "title": "Role",
          "type": "string"
        },
        "sentence_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sentence Index"
        },
        "support": {
          "enum": [
            "supported",
            "partial",
            "unsupported",
            "nei",
            "not_checked"
          ],
          "title": "Support",
          "type": "string"
        }
      },
      "required": [
        "role",
        "quote_found",
        "numbers_match",
        "support"
      ],
      "title": "ClaimCheck",
      "type": "object"
    },
    "EvalResult": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "$ref": "#/$defs/Access"
        },
        "availability": {
          "enum": [
            "available",
            "beta",
            "preview",
            "research",
            "announced",
            "unknown"
