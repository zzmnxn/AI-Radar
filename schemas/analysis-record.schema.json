    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "verdict": {
      "enum": [
        "accepted",
        "partial",
        "rejected"
