  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "title": "Analysis Id",
      "type": "string"
    },
    "analyzer_version": {
      "title": "Analyzer Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "eval": {
      "$ref": "#/$defs/EvalResult"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceMeta"
