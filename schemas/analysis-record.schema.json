          "title": "Availability",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "how": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 3,
          "title": "How",
          "type": "array"
        },
        "scores": {
          "$ref": "#/$defs/Scores"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "title_ko": {
          "title": "Title Ko",
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        },
        "what": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "What",
          "type": "array"
        },
        "why": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Why",
          "type": "array"
        }
      },
      "required": [
        "scores",
        "category",
        "tags",
        "title_ko",
        "what",
        "why",
        "how",
        "availability",
        "access",
        "claims"
      ],
      "title": "EvalResult",
      "type": "object"
    },
    "EvidenceMeta": {
      "additionalProperties": false,
      "properties": {
        "chars": {
          "minimum": 0,
