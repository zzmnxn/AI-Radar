          "type": "string"
        },
        "link_ok": {
          "title": "Link Ok",
          "type": "boolean"
        },
        "quote_found_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Quote Found Rate",
          "type": "number"
        },
        "supported_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Supported Rate",
          "type": "number"
        }
      },
      "required": [
        "link_ok",
        "level",
        "claims",
        "quote_found_rate",
        "supported_rate"
      ],
      "title": "Verification",
      "type": "object"
    }
