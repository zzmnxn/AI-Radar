          "type": "integer"
        },
        "content_type": {
          "title": "Content Type",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "final_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Final Url",
          "type": "string"
        },
        "http_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Http Status",
          "type": "integer"
        },
        "text_sha256": {
          "title": "Text Sha256",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "final_url",
        "http_status",
        "content_type",
        "fetched_at",
        "text_sha256",
        "chars",
        "truncated"
      ],
      "title": "EvidenceMeta",
      "type": "object"
    },
    "Scores": {
      "additionalProperties": false,
      "properties": {
        "impact": {
          "maximum": 5,
          "minimum": 0,
          "title": "Impact",
          "type": "integer"
        },
        "interest": {
          "maximum": 5,
          "minimum": 0,
          "title": "Interest",
          "type": "integer"
        },
        "novelty": {
          "maximum": 5,
          "minimum": 0,
          "title": "Novelty",
          "type": "integer"
        },
        "practical": {
          "maximum": 5,
          "minimum": 0,
          "title": "Practical",
          "type": "integer"
        },
        "trust": {
          "maximum": 5,
          "minimum": 0,
          "title": "Trust",
          "type": "integer"
        }
      },
      "required": [
        "practical",
        "impact",
        "novelty",
        "trust",
        "interest"
      ],
      "title": "Scores",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "minimum": 0,
